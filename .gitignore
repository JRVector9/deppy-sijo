/target
.DS_Store
sijo_font.png

# 디자인 목업(Figma)의 의존성 — 잠금 파일(pnpm-lock)로 재현되므로 추적하지 않는다
node_modules/

# 벤치·롤백 아티팩트 — 대용량(앱 번들 스냅샷 등)은 추적하지 않는다.
# 예외: artifacts/render-bench/ 는 하위 .gitignore가 집계본(summary.md/csv)만 추적하게 한다.
/artifacts/*
!/artifacts/render-bench/

# 런타임 로그 / 패키징 산출물 / codex CLI 세션 디렉터리 — 소스 아님
/deppy-sijo.log
/Deppy-Sijo-*.zip
/.codex/

# Relay 셸 빌드 산출물(build.sh) — 불변 아카이브와 매니페스트는 배포 파이프라인이 만든다
/web/relay-shell/dist/

# 개발용 Relay 라우트/자격증명 (scripts/relay-dev.sh가 만든다 — 기계마다 다르고 비밀이다)
/.relay-dev.env
