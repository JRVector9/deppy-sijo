# Deppy Relay 신뢰 셸 — production 빌드 환경변수.
#
# 모든 값이 자리표시자다. 실제 좌표는 아직 정해지지 않았다(deploy/relay-shell/README.md).
# 이 파일에 실제 자격증명을 커밋하지 않는다.

# 신뢰 셸 오리진. https://<host>[:port], 끝 슬래시 없음. 기본값은 존재하지 않는다.
SHELL_ORIGIN=https://relay-shell.example.invalid

# 신뢰하지 않는 데이터 평면 오리진. wss://<host>[:port], 끝 슬래시 없음.
# 셸 CSP의 connect-src가 이 값 **하나만** 지명한다. deploy/relay와 같은 값이어야 한다.
RELAY_ORIGIN=wss://relay.example.invalid

# 산출물 디렉터리. CI가 환경마다 다른 경로를 준다 — 두 환경이 서로 덮어쓰지 않게 한다.
RELAY_SHELL_DIST=dist/production

# git이 없는 빌더에서만 명시한다. 있으면 build.sh가 git에서 읽는다.
# GIT_REVISION=
