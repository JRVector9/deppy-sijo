# Deppy Relay 데이터 평면 — production 환경 변수.
#
# 모든 값이 자리표시자다. 실제 좌표는 아직 정해지지 않았다(deploy/relay/README.md 참고).
# 이 파일에 실제 자격증명을 커밋하지 않는다.

# 바인드 주소. TLS edge 뒤 loopback 또는 사설 인터페이스만 사용한다.
DEPPY_RELAY_BIND=REQUIRED-BIND-ADDRESS

# 라우트 목록: <route-hex32>:<credential-hex64>[,...]
# 기본값은 존재하지 않는다. 이 값이 없으면 서버는 기동을 거부한다.
DEPPY_RELAY_ROUTES=REQUIRED-ROUTE-HEX:REQUIRED-CREDENTIAL-HEX

# 로그 필터. 페이로드는 어떤 수준에서도 기록되지 않는다.
RUST_LOG=info
