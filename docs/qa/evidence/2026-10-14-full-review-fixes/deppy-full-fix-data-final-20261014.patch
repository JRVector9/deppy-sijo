+            elapsed < Duration::from_millis(250),
+            "partial TLS record ignored the stop flag"
+        );
+        let mut closed = [0u8; 1];
+        assert_eq!(
+            peer.sock.read(&mut closed).unwrap(),
+            0,
+            "stop must retire the TCP transport"
+        );
+    }
