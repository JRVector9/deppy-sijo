+            assert_eq!(
+                worker.admit_input_batch_checked(id, &[body.as_bytes(), b"\r"], Some(&admission)),
+                Ok(()),
+                "an untouched wide hint must accept explicit input at scroll offset {offset}"
+            );
+            let after = worker
+                .sessions
+                .get_mut(&id)
+                .unwrap()
+                .take_snapshot()
+                .unwrap();
