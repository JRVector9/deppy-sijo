+impl FileTreeUi {
+    pub(super) fn input_regression_listing(&mut self, names: &[&str]) {
+        let root = PathBuf::from("/private/tmp/deppy-file-tree-input-regression");
+        if self.root.as_ref() != Some(&root) {
+            self.set_root(Some(root.clone()));
+        }
