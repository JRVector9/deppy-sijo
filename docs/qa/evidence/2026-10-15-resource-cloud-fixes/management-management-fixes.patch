+        .unwrap();
+        db.save_run(&run).unwrap();
+        run.apply_report(
+            &run.actor(),
+            agent_mcp::RunUpdate {
+                state: agent_mcp::RunState::Completed,
+                progress: Some(100),
+                message: String::new(),
+                result: Some("Durable useful result".into()),
