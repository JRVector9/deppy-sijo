+
+fn descendant_after_shell_exit_teardown(use_kill: bool) {
+    let mut fixture = Fixture::spawn_with_shell_exit("ignore-hup", true);
+    if use_kill {
+        fixture.session.as_mut().unwrap().kill().unwrap();
+    } else {
+        drop(fixture.session.take());
+    }
+    let gone_without_rescue = fixture.wait_for_exit(Duration::from_millis(500));
+    let process = fixture.process.unwrap();
+    drop(fixture);
+    assert!(
+        gone_without_rescue,
+        "captured same-group descendant survived after shell reap: kill={use_kill} identity={process:?}"
+    );
+}
+
+#[test]
+fn samegroup_descendant_after_shell_reap_exits_on_drop() {
+    descendant_after_shell_exit_teardown(false);
+}
+
+#[test]
+fn samegroup_descendant_after_shell_reap_exits_on_kill() {
+    descendant_after_shell_exit_teardown(true);
+}
