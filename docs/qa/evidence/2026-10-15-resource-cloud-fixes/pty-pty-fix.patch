+    fn capture_owned_workloads(&self) -> Vec<workload_signal::FrozenGroup> {
+        let Ok(_child) = self.child.lock() else {
+            tracing::warn!("PTY child mutex poisoned during workload capture");
+            return Vec::new();
+        };
+        let Some(owner) = self.owner_process else {
