+/// Peek at this direct child's exit without consuming its PID. macOS proc_pidinfo/getsid cannot
+/// inspect a zombie, so use waitid's unreaped-child authority instead. Running polls never scan
+/// group membership, and an already consumed PID can never grant new signal authority.
+#[cfg(unix)]
+fn try_wait_unix_child(
+    child: &mut ChildPtyBox,
+    owner: Option<workload_signal::Process>,
+    exit_workload: &Mutex<ExitWorkloadState>,
+) -> std::io::Result<Option<portable_pty::ExitStatus>> {
+    let mut retained = exit_workload
+        .lock()
+        .map_err(|_| std::io::Error::other("PTY exit workload mutex poisoned"))?;
+    #[cfg(any(target_os = "macos", target_os = "linux"))]
+    if !retained.reaped
+        && let Some(owner) = owner
+    {
+        let mut info = std::mem::MaybeUninit::<libc::siginfo_t>::zeroed();
+        // SAFETY: the child mutex serializes every normal reap of this original child. WNOWAIT
+        // leaves its PID allocated while the following same-session group snapshot is taken.
+        let result = unsafe {
+            libc::waitid(
+                libc::P_PID,
+                owner.pid as libc::id_t,
+                info.as_mut_ptr(),
+                libc::WEXITED | libc::WNOHANG | libc::WNOWAIT,
+            )
+        };
+        if result != 0 {
+            let error = std::io::Error::last_os_error();
+            if error.raw_os_error() == Some(libc::EINTR) {
+                return Ok(None); // Retry the non-consuming observation on the next poll.
+            }
+            if error.raw_os_error() != Some(libc::ECHILD) {
+                return Err(error);
+            }
+            // Cached portable-pty exit status may remain after waitpid consumed the child. An
+            // ECHILD observation must never be retried as authority over a later reused PID.
+            retained.reaped = true;
+        } else {
+            let info = unsafe { info.assume_init() };
+            let pid = unsafe { info.si_pid() };
+            if pid == 0 {
+                return Ok(None);
+            }
+            if pid != owner.pid {
+                return Err(std::io::Error::other(format!(
+                    "PTY child exit identity mismatch: expected={} observed={pid} code={}",
+                    owner.pid, info.si_code
+                )));
+            }
+            // Darwin can report a stopped child even with WEXITED alone. A stop/continue is
+            // neither an exit nor permission to consume status or capture cached group IDs.
+            if matches!(
+                info.si_code,
+                libc::CLD_STOPPED | libc::CLD_TRAPPED | libc::CLD_CONTINUED
+            ) {
+                return Ok(None);
+            }
+            if !matches!(
+                info.si_code,
+                libc::CLD_EXITED | libc::CLD_KILLED | libc::CLD_DUMPED
+            ) {
+                return Err(std::io::Error::other(format!(
+                    "PTY child exit notification mismatch: pid={pid} code={}",
+                    info.si_code
+                )));
+            }
+            if retained.captured.is_none() {
+                match workload_signal::FrozenGroup::capture(owner.group, owner) {
+                    Ok(group) => retained.captured = Some(group),
+                    Err(error) => {
+                        tracing::debug!("PTY pre-reap workload capture skipped: {error:#}");
+                    }
+                }
+            }
+        }
+    }
+    #[cfg(not(any(target_os = "macos", target_os = "linux")))]
+    let _ = owner;
+    let status = child.try_wait()?;
+    if status.is_some() {
+        retained.reaped = true;
+    }
+    Ok(status)
 }
 
