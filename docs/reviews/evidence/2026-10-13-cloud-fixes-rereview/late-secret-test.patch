+    #[test]
+    fn rereview_late_secret_registration_scrubs_cached_legacy_run_publication() {
+        let (mut bridge, target) = setup();
+        let text = "Report: fixture-secret-\naccess-token-123456789";
+        let expected = "Report: [REDACTED]";
+        let mut run = CloudRun::new(
+            "late-secret-run",
+            agent_mcp::LEGACY_CONNECTION_ID,
+            "Legacy",
+            &target.workspace,
+            &target.id,
+            &target.generation,
+            text,
+            text,
+            now() as i64,
+        )
+        .unwrap();
+        run.message = text.into();
+        run.result = Some(text.into());
+        let token = bridge.operation_token();
+        assert!(bridge.history.request(token, Job::SaveRun { run }).is_ok());
+        assert!(matches!(
+            bridge.history.wait().unwrap().result,
+            ResultKind::SaveRun(Ok(()))
+        ));
+        bridge.management.bootstrap_started = false;
+        bridge.poll_management();
+        bridge.drain_history(|_, _| panic!("legacy bootstrap must not emit input"));
+        assert_eq!(bridge.cloud_runs()[0].title, text, "loaded before registration");
+
+        let secret = secret::SecretString::new("fixture-secret-access-token-123456789".into());
+        let _lease = bridge
+            .redaction
+            .acquire_execution_lease(&[&secret])
+            .unwrap();
+        assert_eq!(bridge.redaction.redact_wrapped_text(text), expected);
+        let native_cache_masked = bridge.cloud_runs()[0].title == expected;
+        let snapshot = bridge.cloud_snapshot();
+        let snapshot_title_masked = snapshot.runs[0].title == expected;
+        let snapshot_message_masked = snapshot.runs[0].message == expected;
+        let snapshot_result_masked = snapshot.runs[0].result.as_deref() == Some(expected);
+        println!(
+            "native_cache_masked={native_cache_masked}; snapshot_title_masked={snapshot_title_masked}; snapshot_message_masked={snapshot_message_masked}; snapshot_result_masked={snapshot_result_masked}"
+        );
+        assert!(
+            native_cache_masked
+                && snapshot_title_masked
+                && snapshot_message_masked
+                && snapshot_result_masked,
+            "late registration must mask native-visible cache and published legacy run fields"
+        );
+    }
