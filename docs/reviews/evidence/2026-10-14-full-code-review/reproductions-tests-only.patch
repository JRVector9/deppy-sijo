+            libc::killpg(foreground as libc::pid_t, libc::SIGKILL);
+        }
+        drop(session);
+        assert!(
+            foreground_stopped,
+            "freeze returned Ok but only shell group stopped: shell={initial_group}:{initial_state}, foreground={foreground}:{foreground_state}"
+        );
