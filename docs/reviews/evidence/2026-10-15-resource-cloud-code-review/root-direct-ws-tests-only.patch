--- a/crates/web-remote/src/ws_api.rs
+++ b/crates/web-remote/src/ws_api.rs
@@ -740,4 +740,37 @@ mod tests {
         assert!(!ok, "stop 상태인데 인증이 성공/대기했다");
         drop(client);
     }
+    #[test]
+    fn review_20261015_auth_rejects_valid_message_completed_after_whole_deadline() {
+        use std::io::Write;
+        use std::net::TcpListener;
+        let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+        let mut client = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (server, _) = listener.accept().unwrap();
+        server.set_read_timeout(Some(WS_TICK)).unwrap();
+        let mut ws = WebSocket::from_raw_socket(server, Role::Server, None);
+        let mut payload = format!(r#"{{"type":"auth","v":{},"token":"tok"}}"#, PROTOCOL_VERSION).into_bytes();
+        payload.extend(std::iter::repeat_n(b' ', 160));
+        assert!(matches!(ClientMsg::parse(std::str::from_utf8(&payload).unwrap()), Some(ClientMsg::Auth { .. })), "fixture must be a valid auth frame");
+        let mut frame = vec![0x81, 0xfe];
+        frame.extend_from_slice(&(payload.len() as u16).to_be_bytes());
+        frame.extend_from_slice(&[0; 4]);
+        frame.extend_from_slice(&payload);
+        client.write_all(&frame[..10]).unwrap();
+        let writer = std::thread::spawn(move || {
+            for chunk in frame[10..].chunks(5) {
+                std::thread::sleep(Duration::from_millis(160));
+                if client.write_all(chunk).is_err() { break; }
+            }
+        });
+        let start = Instant::now();
+        let accepted = authenticate(&mut ws, "tok", &AtomicBool::new(false), AUTH_TIMEOUT);
+        let elapsed = start.elapsed();
+        drop(ws);
+        writer.join().unwrap();
+        eprintln!("auth whole deadline={:?}; elapsed={elapsed:?}; late valid message accepted={accepted}", AUTH_TIMEOUT);
+        assert!(!accepted, "a valid auth message completed after the whole deadline must be rejected");
+        assert!(elapsed <= AUTH_TIMEOUT + WS_TICK + Duration::from_millis(100), "auth whole deadline exceeded: {elapsed:?}");
+    }
+
 }
